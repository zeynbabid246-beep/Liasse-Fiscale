  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6205">
    <xsd:annotation>
      <xsd:documentation>Etat de resultat technique de l'assurances et/ou de la réassurance non vie</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F62050001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNV1 Primes acquises (Opérations brutes). "F62050002" + "F62050003"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNV1 Primes acquises (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNV 11 Primes émises et acceptées  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNV 11 Primes émises et acceptées  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNV12 Variation de la provision pour primes non acquises  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNV12 Variation de la provision pour primes non acquises  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT3 Produits de placements alloués transférés de l'�tat de résultat  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT3 Produits de placements alloués transférés de l'�tat de résultat  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNV2 Autres produits techniques  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNV2 Autres produits techniques  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNV1 Charge de sinistres (Opérations brutes). "F62050007" + "F62050008"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CHNV1 Charge de sinistres (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNV 11 Montants payés  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CHNV 11 Montants payés  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNV 12 Variation de la provision pour sinistres  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CHNV 12 Variation de la provision pour sinistres  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNV2 Variation des autres provisions techniques (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CHNV2 Variation des autres provisions techniques (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62050010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNV3 Participation aux bénéfices et ristournes  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CHNV3 Participation aux bénéfices et ristournes  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>

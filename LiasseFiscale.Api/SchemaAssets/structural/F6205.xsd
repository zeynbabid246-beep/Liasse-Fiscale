<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:lf="http://www.impots.finances.gov.tn/liasse" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" targetNamespace="http://www.impots.finances.gov.tn/liasse" elementFormDefault="qualified" attributeFormDefault="unqualified" vc:minVersion="1.1">
  <xsd:simpleType name="T_NumMatriculeFiscal">
    <xsd:annotation>
      <xsd:documentation>Numero matricule fiscal</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="7" />
      <xsd:whiteSpace value="collapse" />
      <xsd:pattern value="[0-9]{7}" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_CleMatriculeFiscal">
    <xsd:annotation>
      <xsd:documentation>Clé matricule fiscal</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="1" />
      <xsd:pattern value="[ABCDEFGHJKLMNPQRSTVWXYZ]" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_CodeCategorie">
    <xsd:annotation>
      <xsd:documentation>Code categorie</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="1" />
      <xsd:enumeration value="C" />
      <xsd:enumeration value="M" />
      <xsd:enumeration value="N" />
      <xsd:enumeration value="P" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_CodeTva">
    <xsd:annotation>
      <xsd:documentation>Code TVA</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="1" />
      <xsd:enumeration value="A" />
      <xsd:enumeration value="B" />
      <xsd:enumeration value="D" />
      <xsd:enumeration value="P" />
      <xsd:enumeration value="N" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_MatriculeFiscal_13c">
    <xsd:annotation>
      <xsd:documentation>Matricule fiscal de structure : MAT-CLE-TVA-CAT-ETB</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:pattern value="[0-9]{7}[ABCDEFGHJKLMNPQRSTVWXYZ][ABDNP][CMNP][0]{3}" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_Annee">
    <xsd:annotation>
      <xsd:documentation>Année</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:gYear" />
  </xsd:simpleType>
  <xsd:simpleType name="T_TypeIdentifiantContribuable">
    <xsd:annotation>
      <xsd:documentation>Type identifiant contribuable</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="1" />
      <xsd:enumeration value="1">
        <xsd:annotation>
          <xsd:documentation>Matricule fiscal</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="2">
        <xsd:annotation>
          <xsd:documentation>CIN</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="3">
        <xsd:annotation>
          <xsd:documentation>Carte de sejour</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="4">
        <xsd:annotation>
          <xsd:documentation>Autre identifiant</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_ChaineTexte250">
    <xsd:annotation>
      <xsd:documentation>Chaine de 250 caracteres au maximum</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="250" />
      <xsd:whiteSpace value="collapse" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_Date">
    <xsd:annotation>
      <xsd:documentation>Date au format dd/mm/yyyy (Les années sont comprises entre 1900 et 2099)</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:pattern value="((31/(0[13578]|1[02])/((19|20)\d{2}))|((0[1-9]|[12]\d|30)/(0[13456789]|1[012])/((19|20)\d{2}))|((0[1-9]|1\d|2[0-8])/02/((19|20)\d{2}))|(29/02/(19|20)((0[048]|[2468][048]|[13579][26]))))" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_ActeDeDepot">
    <xsd:annotation>
      <xsd:documentation>Actes de dépôts</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:minLength value="1" />
      <xsd:maxLength value="1" />
      <xsd:enumeration value="0" />
      <xsd:enumeration value="1" />
      <xsd:enumeration value="2" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_NatureDepot">
    <xsd:annotation>
      <xsd:documentation>Nature dépôt : Definitif ou Provisoire</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:minLength value="1" />
      <xsd:maxLength value="1" />
      <xsd:enumeration value="D" />
      <xsd:enumeration value="P" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="T_ModeleLiasse">
    <xsd:annotation>
      <xsd:documentation>Modele liasse fiscale</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:length value="1" />
      <xsd:enumeration value="G">
        <xsd:annotation>
          <xsd:documentation>Cas general</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="B">
        <xsd:annotation>
          <xsd:documentation>Banques</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="A">
        <xsd:annotation>
          <xsd:documentation>Assurances et réassurances</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="C">
        <xsd:annotation>
          <xsd:documentation>Associations, micro-credits</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="O">
        <xsd:annotation>
          <xsd:documentation>OPCVM</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>

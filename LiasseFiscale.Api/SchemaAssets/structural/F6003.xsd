  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6003">
    <xsd:annotation>
      <xsd:documentation>Etat de resultat (Cas general)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F60030001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Produits d'exploitation (Net Exercice). "F60030002" + "F60030014" + "F60030015"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Produits d'exploitation (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Revenus (Net Exercice). "F60030003" + "F60030006"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Revenus (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes nettes des marchandises (Net Exercice). "60030004" - "60030005"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes nettes des marchandises (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes de Marchandises (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes de Marchandises (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Rabais, Remises et Ristournes (3R) accordés/ventes de Marchandises (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Rabais, Remises et Ristournes (3R) accordés/ventes de Marchandises (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes nettes de la production (Net Exercice). "F60030007" + "F60030008" + "F60030009" + "F60030010" + "F60030011" + "F60030012" - "F60030013"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes nettes de la production (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes de Produits Finis (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes de Produits Finis (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes de Produits Intermédiaires (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes de Produits Intermédiaires (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes de Produits Résiduels (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes de Produits Résiduels (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes des Travaux (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes des Travaux (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60030011" maxOccurs="1">
                <xsd:annotation>

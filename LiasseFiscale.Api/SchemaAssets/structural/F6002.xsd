  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6002">
    <xsd:annotation>
      <xsd:documentation>Bilan-passifs (Cas general)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F60020001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Capitaux propres (Net Exercice).  "F60020006" + "F60020007"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Capitaux propres (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Capital social (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Capital social (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Réserves (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Réserves (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Autres capitaux propres (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Autres capitaux propres (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Résultats reportés (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Résultats reportés (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Capitaux propres avant résultat de l'exercice (Net Exercice) F60020002 + F60020003 + F60020004 + F60020005 </xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Capitaux propres avant résultat de l'exercice (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020007">
                <xsd:annotation>
                  <xsd:documentation>résultat de l'exercice (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="résultat de l'exercice (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Total Passifs (Net Exercice). "F60020009" + "F60020031"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Total Passifs (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Passifs non courants (Net Exercice). "F60020010" + "F60020019" + "F60020022"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Passifs non courants (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Emprunts (Net Exercice). "F60020011" + "F60020012" + "F60020013" + "F60020014" + "F60020015" + "F60020016" + "F60020017" + "F60020018"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Emprunts (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60020011" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Emprunts obligataires (assortis de s�ret�s) (Net Exercice)</xsd:documentation>
                </xsd:annotation>

  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6206">
    <xsd:annotation>
      <xsd:documentation>Etat de resultat technique de l'assurances et/ou de la réassurance vie</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F62060001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV1 Primes (Opérations brutes). "F62060002"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV1 Primes (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV11 Primes émises et acceptées  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV11 Primes émises et acceptées  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV2 Produits de placements (Opérations brutes). "F62060004" + "F62060005" + "F62060006" + "F62060007"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV2 Produits de placements (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV21 Revenus des placements  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV21 Revenus des placements  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV22 .Produits des autres placements (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV22 .Produits des autres placements (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV23 Reprise de corrections de valeur sur placements (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV23 Reprise de corrections de valeur sur placements (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV24 Profits provenant de la réalisation des placements et de change  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV24 Profits provenant de la réalisation des placements et de change  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Total primes et produits de placement (Sous total 2) (Opérations brutes). "F62060001" + "F62060003"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Total primes et produits de placement (Sous total 2) (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV3 Plus-values non réalisées sur placements (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV3 Plus-values non réalisées sur placements (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62060010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRV4 Autres produits techniques  (Opérations brutes)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRV4 Autres produits techniques  (Opérations brutes)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>

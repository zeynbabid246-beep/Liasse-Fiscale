                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Gains/portefeuille-titres commercial et  op�rations Fin� (Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F61030005" maxOccurs="1">

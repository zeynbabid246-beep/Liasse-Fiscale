  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6203">
    <xsd:annotation>
      <xsd:documentation>Etat de resultat (Assurances et reassurances)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F62030001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>RTNV Résultat technique de l'assurance et/ou de la réassurance non vie  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="RTNV Résultat technique de l'assurance et/ou de la réassurance non vie  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>RTV Résultat technique de l'assurance et/ou de la réassurance vie  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="RTV Résultat technique de l'assurance et/ou de la réassurance vie  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT1 Produits des placements (assurance et/ou réassurance non vie) (Net Exercice). "F62030004" + "F62030005" + "F62030006" + "F62030007"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT1 Produits des placements (assurance et/ou réassurance non vie) (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT11 .Revenus des placements (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT11 .Revenus des placements (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT12 .Produits des autres placements (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT12 .Produits des autres placements (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT13 .Reprise de corrections de valeur sur placements   (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT13 .Reprise de corrections de valeur sur placements   (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT14 .Profits provenant de la réalisation des placements (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT14 .Profits provenant de la réalisation des placements (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Sous total 1 (Net Exercice). "F62030001" + "F62030002" + "F62030003"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Sous total 1 (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PRNT3 Produits des placements alloués, transférés de l'�tat de Résultat technique de l'assurance et/ou de la réassurance vie (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PRNT3 Produits des placements alloués, transférés de l'�tat de Résultat technique de l'assurance et/ou de la réassurance vie (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62030010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CHNT1 Charges des placements (assurance et/ou réassurance non vie) (Net Exercice). "F62030011" + "F62030012" + "F62030013"</xsd:documentation>
                </xsd:annotation>

  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6303">
    <xsd:annotation>
      <xsd:documentation>Etat de résultat (OPCVM)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F63030001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PR 1 - Revenus du portefeuille titres  (Net Exercice). "F63030002" + "F63030003" + "F63030004"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PR 1 - Revenus du portefeuille titres  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>a- Dividendes  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="a- Dividendes  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>b - Revenus des obligations et valeurs assimilées  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="b - Revenus des obligations et valeurs assimilées  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>c - Revenus des autres valeurs  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="c - Revenus des autres valeurs  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PR 2 - Revenus des placements monétaires  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PR 2 - Revenus des placements monétaires  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation> Total des revenus des placements (Net Exercice). "F63030001" + "F63030005"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default=" Total des revenus des placements (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CH 1 - Charges de gestion des placements  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CH 1 - Charges de gestion des placements  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Revenu net des placements (Net Exercice). "F63030006" - "F63030007"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Revenu net des placements (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>PR 3 - Autres produits  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="PR 3 - Autres produits  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>CH 2 - Autres charges  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="CH 2 - Autres charges  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F63030011" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>résultat d'exploitation (Net Exercice). "F63030008" + "F63030009" - "F63030010"</xsd:documentation>
                </xsd:annotation>

  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6004">
    <xsd:annotation>
      <xsd:documentation>Etat de flux de tresorerie (Cas general)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F60040001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Flux de Trésorerie liés à l'Exploitation (Net Exercice). "F60040002" - "F60040012" - "F60040023" - "F60040032" - "F60040045" </xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Encaissements reçus des clients (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Encaissements reçus des clients (Net Exercice). "F60040003" - "F60040004" + "F60040005" + "F60040006" - "F60040007" + "F60040008" - "F60040009" - "F60040010" +"F60040011"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Encaissements reçus des clients (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>S.Debiteurs Clts et Rattaches et Regul.bruts en Debut d'exercice (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="S.Debiteurs Clts et Rattaches et Regul.bruts en Debut d'exercice (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>S.Crediteurs Clts et Rattaches et Regul.bruts en Debut d'exercice (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="S.Crediteurs Clts et Rattaches et Regul.bruts en Debut d'exercice (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ventes TTC (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ventes TTC (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Ajustements des ventes des exercices anterieurs portes en modifications comptables (compte 128) majores de la TVA (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Ajustements des ventes des exercices anterieurs portes en modifications comptables (compte 128) majores de la TVA (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Creances clients passees en pertes (comptes 634) (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Creances clients passees en pertes (comptes 634) (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Gains de change sur creances clients en devises   (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Gains de change sur creances clients en devises   (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Pertes de change sur creances client en devises  (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Pertes de change sur creances client en devises  (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F60040010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>S.Debiteurs Clts et Rattaches et Regul.bruts en Fin d'exercice (Net Exercice)</xsd:documentation>
                </xsd:annotation>

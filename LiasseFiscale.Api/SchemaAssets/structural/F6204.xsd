  <xsd:complexType name="T_Entete">
    <xsd:annotation>
      <xsd:documentation>Entête d'une déclaration</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="MatriculeFiscalDeclarant" type="lf:T_MatriculeFiscal_13c" />
      <xsd:element name="NometPrenomouRaisonSociale" type="lf:T_ChaineTexte250" />
      <xsd:element name="Activite" type="lf:T_ChaineTexte250" />
      <xsd:element name="Adresse" type="lf:T_ChaineTexte250" />
      <xsd:element name="Exercice" type="lf:T_Annee" />
      <xsd:element name="DateDebutExercice" type="lf:T_Date" />
      <xsd:element name="DateClotureExercice" type="lf:T_Date" />
      <xsd:element name="ActeDeDepot" type="lf:T_ActeDeDepot" default="0" />
      <xsd:element name="NatureDepot" type="lf:T_NatureDepot" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="F6204">
    <xsd:annotation>
      <xsd:documentation>Etat de flux de trésorerie - méthode directe (Assurances- réassurances)</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="VersionDocument" type="xsd:string" />
        <xsd:element name="Entete" type="lf:T_Entete" />
        <xsd:element name="Details">
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="F62040001" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Flux de trésorerie net provenant des activités d'exploitation (Net Exercice). "F62040002" - "F62040003" + "F62040004" - "F62040005" - "F62040006" - "F62040007" + "F62040008" + "F62040009" - "F62040010" - "F62040011" + "F62040012" + "F62040013" - "F62040014" + "F62040015" - "F62040016" - "F62040017" + "F62040018"</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_Nombre15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Flux de trésorerie net provenant des activités d'exploitation (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040002" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Encaissements des primes reçues des assurés (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Encaissements des primes reçues des assurés (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040003" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Sommes versées pour paiement des sinistres (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Sommes versées pour paiement des sinistres (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040004" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Encaissements des primes reçues (acceptations) (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Encaissements des primes reçues (acceptations) (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040005" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Sommes versées pour les sinistres (acceptations) (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Sommes versées pour les sinistres (acceptations) (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040006" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Commissions versées sur les acceptations (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Commissions versées sur les acceptations (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040007" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Décaissements de primes pour les cessions (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Décaissements de primes pour les cessions (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040008" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Encaissements des sinistres pour les cessions (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Encaissements des sinistres pour les cessions (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040009" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Commissions reçues sur les cessions (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="lf:T_NombrePositif15">
                      <xsd:attribute name="Libelle" type="xsd:string" default="Commissions reçues sur les cessions (Net Exercice)" />
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="F62040010" maxOccurs="1">
                <xsd:annotation>
                  <xsd:documentation>Commissions versées aux intermédiaires (Net Exercice)</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>

# ==============================================================================
# Portail Liasse Fiscale - Variables d'environnement
# ==============================================================================

# Port d'écoute du serveur web (défaut : 3000)
PORT=3000

# Environnement d'exécution (development | production)
NODE_ENV=development

# Clé secrète pour la signature et la vérification des tokens JWT
# Remplacez par une clé secrète longue et aléatoire en environnement de production
JWT_SECRET=LiasseFiscaleSecretKey2026_DGI_SuperSecureKey_MinFinances

# Chaîne de connexion PostgreSQL (optionnelle)
# Format : postgresql://<utilisateur>:<mot_de_passe>@<hôte>:<port>/<nom_de_base>
# Si cette variable n'est pas définie ou si la base n'est pas accessible,
# l'application bascule automatiquement en mode stockage mémoire / fichiers locaux.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liasse_fiscale_db

